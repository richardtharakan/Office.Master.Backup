<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OfficeMasterBackup" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">sans</item>

        <!-- This changes the launch background from white to dark -->
        <item name="android:windowBackground">#071823</item>
        <item name="android:colorAccent">#2A6B95</item>

        <!-- Status/navigation bar colors -->
        <item name="android:statusBarColor">#071823</item>
        <item name="android:navigationBarColor">#071823</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>